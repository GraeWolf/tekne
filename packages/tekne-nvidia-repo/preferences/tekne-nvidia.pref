# NVIDIA's repository may only provide the display driver, built from these
# source packages (DEC-041, DEC-026). Its CUDA packages (cuda-drivers shares
# a source package with the driver), its nvidia-driver-pinning-* package
# (which would add its own APT pin) and everything else it publishes can
# never be installed.
Package: cuda-*
Pin: origin "developer.download.nvidia.com"
Pin-Priority: -1

Package: src:nvidia-graphics-drivers src:nvidia-kmod-open src:nvidia-modprobe src:egl-wayland2 src:egl-x11 src:nvidia-egl-gbm
Pin: origin "developer.download.nvidia.com"
Pin-Priority: 500

Package: *
Pin: origin "developer.download.nvidia.com"
Pin-Priority: -1
