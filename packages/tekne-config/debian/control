# Firewall and keyring PAM profile (DEC-023, DEC-030)
 nftables,
 libpam-gnome-keyring,
 libpam-runtime,
# Commands the helper scripts in /usr/bin call. The programs the herbstluftwm
# autostart starts come with tekne-desktop.
 herbstluftwm,
 alacritty,
