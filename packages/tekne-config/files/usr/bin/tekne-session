#!/bin/sh
# The Tekne X session, registered as the x-session-manager alternative.
# startx -> /etc/X11/Xsession (which starts the D-Bus session bus) -> here.
# A user's own ~/.xsession or ~/.xinitrc takes precedence over this.

# Secret Service for Brave, Firefox, Melia and NetworkManager (DEC-030).
# PAM already started and unlocked the keyring at login; this attaches to it.
if command -v gnome-keyring-daemon >/dev/null 2>&1; then
	eval "$(gnome-keyring-daemon --start --components=secrets 2>/dev/null)"
	export GNOME_KEYRING_CONTROL
fi

# XDG user directories (Documents, Downloads, ...): desktop environments run
# this from XDG autostart, which herbstluftwm doesn't read. It's idempotent.
command -v xdg-user-dirs-update >/dev/null 2>&1 && xdg-user-dirs-update

user_autostart="${XDG_CONFIG_HOME:-$HOME/.config}/herbstluftwm/autostart"
if [ -x "${user_autostart}" ]; then
	exec herbstluftwm
fi
exec herbstluftwm --autostart /usr/share/tekne/herbstluftwm/autostart
