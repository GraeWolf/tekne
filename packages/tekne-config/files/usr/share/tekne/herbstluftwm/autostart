#!/usr/bin/env bash
# Tekne's default herbstluftwm configuration, used unless the user has
# ~/.config/herbstluftwm/autostart. To customise, copy this file there.
# Keybindings are documented in /usr/share/tekne/keybindings.txt (Mod+F1).

# Every herbstclient call is a new process plus an X round trip, which adds up
# to several seconds on a freshly booted live system. So settings are queued
# with hc and sent as a single "herbstclient chain" call at the end.
queue=()
hc() { queue+=(".-." "$@"); }

hc emit_hook reload
hc keyunbind --all
hc mouseunbind --all

Mod=Mod4    # Super

# Applications and menus
hc keybind $Mod-Return spawn tekne-terminal
hc keybind $Mod-space spawn rofi -show drun
hc keybind $Mod-Tab spawn rofi -show window
hc keybind $Mod-v spawn copyq toggle
hc keybind $Mod-F1 spawn tekne-keys
hc keybind $Mod-Shift-e spawn tekne-powermenu
hc keybind $Mod-Escape spawn loginctl lock-session
hc keybind $Mod-p spawn tekne-screenshot full
hc keybind $Mod-Shift-p spawn tekne-screenshot select

# Window manager
hc keybind $Mod-Shift-r reload
hc keybind $Mod-w close
hc keybind $Mod-h focus left
hc keybind $Mod-j focus down
hc keybind $Mod-k focus up
hc keybind $Mod-l focus right
hc keybind $Mod-Shift-h shift left
hc keybind $Mod-Shift-j shift down
hc keybind $Mod-Shift-k shift up
hc keybind $Mod-Shift-l shift right
hc keybind $Mod-Control-h resize left +0.02
hc keybind $Mod-Control-j resize down +0.02
hc keybind $Mod-Control-k resize up +0.02
hc keybind $Mod-Control-l resize right +0.02
hc keybind $Mod-u split bottom 0.5
hc keybind $Mod-o split right 0.5
hc keybind $Mod-r remove
hc keybind $Mod-f fullscreen toggle
hc keybind $Mod-s set_attr clients.focus.floating toggle
hc keybind $Mod-Shift-space cycle_layout 1

# Media and brightness keys
hc keybind XF86AudioRaiseVolume spawn pamixer --increase 5
hc keybind XF86AudioLowerVolume spawn pamixer --decrease 5
hc keybind XF86AudioMute spawn pamixer --toggle-mute
hc keybind XF86MonBrightnessUp spawn brightnessctl set +5%
hc keybind XF86MonBrightnessDown spawn brightnessctl set 5%-

# Mouse: move and resize floating windows
hc mousebind $Mod-Button1 move
hc mousebind $Mod-Button3 resize

# Tags 1-9
tag_names=( {1..9} )
hc rename default "${tag_names[0]}"
for i in "${!tag_names[@]}"; do
	hc add "${tag_names[$i]}"
	hc keybind "$Mod-$((i + 1))" use_index "$i"
	hc keybind "$Mod-Shift-$((i + 1))" move_index "$i"
done

# Appearance: Tokyo Night (DEC-034)
hc attr theme.tiling.reset 1
hc attr theme.floating.reset 1
hc set frame_border_width 1
hc set frame_gap 4
hc set window_gap 0
hc set frame_padding 0
hc set always_show_frame on
hc set frame_bg_transparent on
hc set frame_border_active_color '#7aa2f7'
hc set frame_border_normal_color '#292e42'
hc attr theme.border_width 2
hc attr theme.active.color '#7aa2f7'
hc attr theme.normal.color '#292e42'
hc attr theme.urgent.color '#f7768e'
hc set focus_follows_mouse off
hc set tree_style '╾│ ├└╼─┐'

# Rules
hc unrule -F
hc rule focus=on
hc rule floatplacement=smart
hc rule windowtype~'_NET_WM_WINDOW_TYPE_(DIALOG|UTILITY|SPLASH)' floating=on
hc rule windowtype='_NET_WM_WINDOW_TYPE_DIALOG' focus=on
hc rule windowtype~'_NET_WM_WINDOW_TYPE_(NOTIFICATION|DOCK|DESKTOP)' manage=off
hc rule fixedsize floating=on
# Windows the bar opens float, centred: nmtui (tekne-nmtui), Blueman's manager
# and Pavucontrol, however they're started.
hc rule class=tekne-float floating=on floatplacement=center
hc rule class~'[Bb]lueman-manager' floating=on floatplacement=center
hc rule class~'[Pp]avucontrol' floating=on floatplacement=center

hc unlock
hc detect_monitors
herbstclient chain "${queue[@]}"

# Session programs, started once (herbstluftwm re-runs this file on reload)
# Wallpaper from tekne-branding, or a plain Tokyo Night background without it
if [ -r /usr/share/backgrounds/tekne/tekne.png ]; then
	feh --no-fehbg --bg-fill /usr/share/backgrounds/tekne/tekne.png
else
	xsetroot -solid '#1a1b26'
fi
tekne-run-once pipewire
# WirePlumber and pipewire-pulse exit if PipeWire isn't listening yet, which
# left some sessions without audio: wait (up to 5 s) for its socket first.
pw_socket="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pipewire-0"
for _ in $(seq 50); do
	[ -S "${pw_socket}" ] && break
	sleep 0.1
done
tekne-run-once wireplumber
tekne-run-once pipewire-pulse
tekne-run-once lxpolkit
tekne-run-once picom picom --config /usr/share/tekne/picom.conf
tekne-run-once dunst
tekne-run-once copyq copyq --start-server
tekne-run-once blueman-applet
tekne-run-once xss-lock xss-lock --transfer-sleep-lock -- i3lock --nofork --color=1a1b26

# polybar's battery module defaults to BAT0 and ADP1, but laptops also use
# BAT1, AC, ACAD and so on. Pass it the system's own names. Scope "Device"
# marks the batteries of mice and other peripherals, not the laptop's.
for supply in /sys/class/power_supply/*; do
	[ "$(cat "${supply}/scope" 2>/dev/null)" = Device ] && continue
	case "$(cat "${supply}/type" 2>/dev/null)" in
		Battery) : "${TEKNE_BATTERY:=${supply##*/}}" ;;
		Mains)   : "${TEKNE_ADAPTER:=${supply##*/}}" ;;
	esac
done
export TEKNE_BATTERY TEKNE_ADAPTER
tekne-run-once polybar polybar --config=/usr/share/tekne/polybar/config.ini tekne
